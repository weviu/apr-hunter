# Copy this file to .env.local and fill in all values.
# Never commit .env.local to version control.

# ─── Database ───────────────────────────────────────────────────────────────
# MongoDB URI pointing at the Docker instance (same container as apr-hunter)
MONGODB_URI=

# ─── Auth & Crypto ──────────────────────────────────────────────────────────
# Random string ≥ 32 characters  used to derive session tokens
SESSION_SECRET=

# AES-256-GCM key for encrypting exchange API secrets at rest
# Must be exactly 64 hex characters (32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ─── Cron ───────────────────────────────────────────────────────────────────
# Secret compared (constant-time) against X-Cron-Secret header on /api/cron/refresh-apr
# Random string ≥ 32 characters
CRON_SECRET=

# ─── APR Sync ───────────────────────────────────────────────────────────────
# Set to 'true' to call live exchange APIs during sync; defaults to 'false' (sample data)
ENABLE_LIVE_EXCHANGE_FETCH=false

# ─── Exchange API Keys (server default  used for public APR scraping) ──────
# These are NOT per-user keys. Leave blank to use sample data.
BINANCE_API_KEY=
BINANCE_API_SECRET=

OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_PASSPHRASE=

# ─── Prices ─────────────────────────────────────────────────────────────────
# Optional. Falls back to the public CoinGecko API if absent.
COINGECKO_API_KEY=

# ─── Public (exposed to browser via NEXT_PUBLIC_ prefix) ────────────────────
# Full URL of the deployed app (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# RainbowKit / WalletConnect project ID  obtain from https://cloud.walletconnect.com
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# ─── Web3 wallet auto-detect (server-side) ──────────────────────────────────
# Sepolia RPC URL (e.g. dRPC/Alchemy/Infura) used to read on-chain Aave positions.
RPC_URL_SEPOLIA=
# Optional stage safety net: a Sepolia address with an Aave V3 supply, scanned as
# a fallback when the connected wallet has no detectable positions.
DEMO_WALLET_ADDRESS=
